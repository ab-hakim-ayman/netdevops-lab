      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(mikrotik_wireguard_peers_rx_bytes_total{device=\"$device\"}[1m]) * 8",
          "legendFormat": "WireGuard Inbound (RX)",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(mikrotik_wireguard_peers_tx_bytes_total{device=\"$device\"}[1m]) * 8",
          "legendFormat": "WireGuard Outbound (TX)",
          "refId": "B"
        }
      ],
      "title": "WireGuard Tunnel Bandwidth (Dhaka HQ <-> Chittagong Branch)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5000 },
              { "color": "red", "value": 15000 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 25 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "mikrotik_conntrack_entries{device=\"$device\"}",
