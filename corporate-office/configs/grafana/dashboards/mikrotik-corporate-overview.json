        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ Router Health & Real-Time Executive Summary",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "ONLINE" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "up{job=\"mikrotik-exporter\"}",
          "refId": "A"
        }
      ],
      "title": "Exporter Status",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "mikrotik_resource_cpu_load{device=\"$device\"}",
          "refId": "A"
        }
      ],
      "title": "Router CPU Utilization",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 64 },
              { "color": "green", "value": 128 }
            ]
          },
          "unit": "decbytes"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "mikrotik_resource_free_memory{device=\"$device\"}",
          "refId": "A"
        }
      ],
      "title": "Free Memory (RAM)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 180 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "mikrotik_wireguard_peers_last_handshake_seconds{device=\"$device\"}",
          "refId": "A"
        }
      ],
      "title": "WireGuard Last Handshake",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(mikrotik_dhcp_lease_active{device=\"$device\"} == 1) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Active DHCP Leases",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "🌐 Dual ISP WAN & Recursive Failover Monitor",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "bps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(mikrotik_interface_receive_bytes_total{device=\"$device\", interface=\"ether1\"}[1m]) * 8",
          "legendFormat": "ISP 1 Primary - Download (RX)",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(mikrotik_interface_transmit_bytes_total{device=\"$device\", interface=\"ether1\"}[1m]) * 8",
          "legendFormat": "ISP 1 Primary - Upload (TX)",
          "refId": "B"
        }
      ],
      "title": "WAN 1 (Primary ISP) Live Bandwidth",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "bps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(mikrotik_interface_receive_bytes_total{device=\"$device\", interface=\"ether2\"}[1m]) * 8",
          "legendFormat": "ISP 2 Backup - Download (RX)",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(mikrotik_interface_transmit_bytes_total{device=\"$device\", interface=\"ether2\"}[1m]) * 8",
          "legendFormat": "ISP 2 Backup - Upload (TX)",
          "refId": "B"
        }
      ],
      "title": "WAN 2 (Backup ISP) Live Bandwidth (Failover)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "🏢 9 Departmental VLANs Bandwidth Breakdown",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "bps"
        }
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 15 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(mikrotik_interface_transmit_bytes_total{device=\"$device\", interface=~\"vlan.*\"}[1m]) * 8",
          "legendFormat": "{{interface}}",
          "refId": "A"
        }
      ],
      "title": "Departmental VLANs Throughput (HR, Admin, Mgmt, Staff, CCTV, VoIP, Hotspot)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bps"
        }
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 15 },
      "id": 9,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "topk(9, rate(mikrotik_interface_transmit_bytes_total{device=\"$device\", interface=~\"vlan.*\"}[1m]) * 8)",
          "legendFormat": "{{interface}}",
          "refId": "A"
        }
      ],
      "title": "Top Bandwidth Consuming VLANs",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 103,
      "title": "🔒 Site-to-Site WireGuard VPN Performance",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
